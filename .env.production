# En producción (Vercel) la página llama a su propio dominio y vercel.json reenvía /api/v1/*, /health,
# /docs y /openapi.json al gateway desplegado en Render. Así no depende del CORS del gateway.
VITE_GATEWAY_URL=/
# Solo para mostrar a qué servidor se conecta
VITE_GATEWAY_DESTINO=https://logitrack-gateway.onrender.com
# Render puede tardar ~1 minuto en despertar: cada petición espera hasta 30 s (y se reintenta)
VITE_API_TIMEOUT_MS=30000
