# Gateway desplegado (Render). Lo usa `npm run build` (Vercel). Para otro gateway sin recompilar: ?api=https://...
VITE_GATEWAY_URL=https://logitrack-gateway.onrender.com
VITE_API_BASE_URL=https://logitrack-gateway.onrender.com/api/v1
# Render puede tardar ~1 minuto en despertar: cada petición espera hasta 30 s (y se reintenta)
VITE_API_TIMEOUT_MS=30000
