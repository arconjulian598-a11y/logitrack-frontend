# URL base del API Gateway de LogiTrack (incluye el prefijo /api/v1). Sin barra final.
VITE_API_BASE_URL=http://localhost:8002/api/v1

# Raíz del gateway (para /health, /docs y /openapi.json, que están fuera de /api/v1).
VITE_GATEWAY_URL=http://localhost:8002

# Tiempo máximo por petición en milisegundos (la ETL manual usa 120 s).
VITE_API_TIMEOUT_MS=20000

# Plantilla de teselas del mapa y su atribución. Por defecto, OpenStreetMap.
# Respete la política de uso de tiles de OSM o configure su propio proveedor.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; colaboradores de <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# Intervalos de actualización (milisegundos).
VITE_POLL_SEGUIMIENTO_MS=4000
VITE_POLL_FLOTA_MS=5000
VITE_POLL_ULTIMA_POSICION_MS=60000
