{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/:ruta*", "destination": "https://logitrack-gateway.onrender.com/api/v1/:ruta*" },
    { "source": "/health", "destination": "https://logitrack-gateway.onrender.com/health" },
    { "source": "/docs", "destination": "https://logitrack-gateway.onrender.com/docs" },
    { "source": "/openapi.json", "destination": "https://logitrack-gateway.onrender.com/openapi.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
