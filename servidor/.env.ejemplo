# Lo crea instalar.sh con claves aleatorias. Si lo escribe a mano, use valores largos y sin espacios.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
# Código que el administrador entrega a operadores y gestores para registrarse (vacío = nadie se registra con esos roles)
CODIGO_REGISTRO_PERSONAL=
# Rama de los repositorios de LogiTrackSystem que se construye
RAMA=feature/automatizacion-envios
# Orígenes permitidos (la página en Vercel y el desarrollo local)
CORS_ORIGINS=https://logitrack-frontend-pi.vercel.app,http://localhost:5173
# 127.0.0.1 = el gateway solo se ve dentro de esta máquina (Tailscale Funnel lo publica). 0.0.0.0 = también en la red local.
GATEWAY_IP=127.0.0.1
